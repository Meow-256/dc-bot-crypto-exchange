# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Ticket System Configuration (Optional)
TICKET_CATEGORY_ID=your_ticket_category_id_here
SUPPORT_ROLE_ID=your_support_role_id_here
LOG_CHANNEL_ID=your_log_channel_id_here
CUSTOMER_ROLE_ID=your_customer_role_id_here

# System Fee Rates (%) (Optional: Defaults -> crypto_to_crypto=8, fiat_to_crypto=8, crypto_to_fiat=10)
FEE_CRYPTO_TO_CRYPTO=8
FEE_FIAT_TO_CRYPTO=8
FEE_CRYPTO_TO_FIAT=10

# OxaPay API Configuration (Required for automated Crypto To Crypto exchange)
OXAPAY_MERCHANT_KEY=your_merchant_api_key_here
OXAPAY_GENERAL_KEY=your_general_api_key_here
OXAPAY_PAYOUT_KEY=your_payout_api_key_here
USD_JPY_RATE=150
